# Copy to .env and adjust. `npm start` loads .env when it exists
# (node --env-file-if-exists). Nothing here is a secret - there are no
# accounts, keys or payment credentials in this project, and there must not be
# any: the game is free to play.

# port the server listens on (the platform usually sets this for you)
PORT=4000

# ---------------------------------------------------------------- persistence
# PostgreSQL connection string. Required for durable rooms, history, the owner
# account, the owner sessions and the admin audit trail. Without it the server
# can only run in memory mode (see ALLOW_MEMORY_ONLY) and the owner control
# centre cannot be bootstrapped.
DATABASE_URL=postgres://tambola:tambola@127.0.0.1:5432/tambola

# schema the server pins its pooled connections to (default: public)
DB_SCHEMA=public

# must be 1 to start without DATABASE_URL at all. Memory mode loses every game
# and cannot sign an owner in - it is for local experiments only.
ALLOW_MEMORY_ONLY=

# ------------------------------------------------------------------- network
# browser origins allowed to open a socket, comma separated, no trailing slash.
# Leave empty for same-origin only - which is what you want when the built
# client is served by this same server. This does NOT enable credentialed admin
# CORS; the owner control centre is same-origin by design.
ALLOWED_ORIGINS=

# exact public origin used in invite links and QR codes, e.g.
# https://games.example.com. Without it invites fall back to the request host
# and the admin UI shows a setup warning. Never put a secret here.
PUBLIC_ORIGIN=

# set to 1 when a reverse proxy terminates TLS so req.ip / req.protocol describe
# the client. Leave unset for direct connections.
TRUST_PROXY=

# set to production to mark cookies Secure (requires HTTPS)
NODE_ENV=development

# ---------------------------------------------------------------- gameplay
# milliseconds between automatic calls (server clamps to 500-120000)
CALL_INTERVAL_MS=8000

# maximum players per room
MAX_PLAYERS=100

# minimum milliseconds between two chat messages from the same player
CHAT_INTERVAL_MS=2000

# ---------------------------------------------------- game session lifetimes
# idle and hard windows for host/player sessions, in milliseconds
SESSION_IDLE_MS=604800000
SESSION_ABSOLUTE_MS=2592000000

# --------------------------------------------------------- owner second factor
# OWNER_MFA_KEY encrypts each enrolled owner's TOTP secret at rest (AES-25-GCM).
# It is 32 random bytes as 64 hex chars OR standard base64 - generate one, do NOT
# reuse it elsewhere, and back it up SEPARATELY from the database: a sealed secret
# can only be opened with this exact value. Leave it unset and the dashboard
# reports MFA as unconfigured and refuses to enroll. Set it to a malformed value
# and the server fails at boot rather than silently storing a secret nobody can
# open. If it is ever lost, already-enrolled owners are recovered with
# `npm run owner:mfa-reset` (see server/RUNBOOK.md 6).
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OWNER_MFA_KEY=

# cosmetic label shown in authenticator apps; changing it does not break devices
MFA_ISSUER=Tambola

# ------------------------------------------------- reliability and observability
# how often the single-instance lease is refreshed; a failed refresh fails the
# process closed (readiness 503, clock disarmed) for the supervisor to act on
LEASE_HEARTBEAT_MS=30000

# background sweep of expired lockouts, spent MFA challenges and dead sessions
MAINTENANCE_INTERVAL_MS=300000

# structured JSON log level: debug | info | warn | error
LOG_LEVEL=info

# leave LOG_FILE unset to log to stdout (preferred - let the platform collect and
# rotate). If you set it, it rotates at LOG_MAX_BYTES keeping LOG_KEEP files.
LOG_FILE=
LOG_MAX_BYTES=5242880
LOG_KEEP=3

# force Secure cookies even when NODE_ENV is not production (unusual setups)
TAMBOLA_COOKIE_SECURE=

# ---------------------------------------------------------- backup and restore
# `npm run db:backup` / `npm run db:restore-check` wrap pg_dump / pg_restore.
# BACKUP_DIR is where timestamped archives + manifests are written (default
# ./backups, git-ignored). Keep it OUTSIDE the live data directory.
BACKUP_DIR=
# tell the scripts where the client tools are: PG_BIN points at a directory on
# this host, or PG_CONTAINER runs them via `docker exec` inside the database
# container (PG_CONTAINER_PORT is that container's internal port, default 5432).
# Use ONE of the two. Prefer PG_BIN in production so the password stays in a
# single local process's environment and never appears in a command line.
PG_BIN=
PG_CONTAINER=
PG_CONTAINER_PORT=5432
# restore-check creates + drops a throwaway database and needs a role that can
# CREATE/DROP DATABASE. It reaches the maintenance db via DATABASE_URL pointed at
# "postgres" unless you give it this explicit maintenance connection string.
RESTORE_ADMIN_DATABASE_URL=

# ------------------------------------------------------------------- owner
# Owner accounts are NOT configured here. The running server never reads an
# owner password from the environment: create or recover the account on the
# server with `npm run owner:create` / `npm run owner:reset`, which read
# OWNER_USERNAME / OWNER_PASSWORD (or a hidden prompt) only for that one
# command. See server/ADMIN.md.
