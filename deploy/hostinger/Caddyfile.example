# Replace tambola.example.com with the configured public domain.
# Caddy obtains and renews TLS certificates and proxies Socket.IO upgrades.
tambola.example.com {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	reverse_proxy 127.0.0.1:4000
}
